{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gotto.example/schemas/release-bundle-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generation", "sourceCommit", "builtAt", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "builtAt": { "type": "string", "format": "date-time" },
    "rollbackOf": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mode"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "mode": { "enum": ["0444", "0555"] }
        }
      }
    }
  }
}
